  <wpt lat="37.95794" lon="-119.78432">
    <name><![CDATA[Beehive Meadows Junction]]></name>
    <desc><![CDATA[]]></desc>
  </wpt>
  <wpt lat="37.95552" lon="-119.71543">
    <name><![CDATA[Rancheria Falls Campsite]]></name>
    <desc><![CDATA[This is an awesome, pretty secluded campsite with fire pit away from most other sites. There's a large rock behind this site and another awesome site standing on the rock. Take some time and try to find a site off the beaten path in this area and you'll be rewarded.]]></desc>
  </wpt>
  <wpt lat="38.01087" lon="-119.73248">
    <name><![CDATA[Lake Vernon split]]></name>
    <desc><![CDATA[If you head over the footbridge, there is an awesome campsite with great lake access for fishing and a fire pit.]]></desc>
  </wpt>
  <wpt lat="38.016" lon="-119.72573">
    <name><![CDATA[Lake Vernon Campsite]]></name>
    <desc><![CDATA[Great campsite with a fire pit overlooking the lake. Great for catching the sun in the morning too.]]></desc>
  </wpt>
  <wpt lat="37.99582" lon="-119.77685">
    <name><![CDATA[Lauren Lake turn-off]]></name>
    <desc><![CDATA[]]></desc>
  </wpt>
