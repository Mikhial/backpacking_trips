---
layout: base.njk
nav: trips
---
<main class="gutter">
  <header class="trip-head">
    <span class="eyebrow">{{ region }}</span>
    <h1>{{ name }}</h1>
    <div class="meta">
      {% if summary %}<span>{{ summary }}</span>{% endif %}
      {% if permit.difficulty %}<span title="{{ permit.why }}"><span class="meter">{{ permit.difficulty | dots | safe }}</span> {{ permit.difficulty | levelName }} permit{% if permit.why %} · {{ permit.why }}{% endif %}</span>{% endif %}
      {% if status %}<span class="chip warn">{{ status }}</span>{% endif %}
    </div>
  </header>
  {% set chartTrips = collections.trips | onlyPage(page.inputPath) %}
  {% set chartOptions = '{"groups": false, "link": false, "alwaysOpen": true}' %}
  {% set chartLegendDots = false %}
  {% include "chart.njk" %}
  {% set areaData = map and (page.fileSlug | hasTrailData) %}
  {% set extras = { trailheads: trailheads, camps: camps, routes: routes } | mapExtras %}
  {% if areaData or extras %}
  <link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
  <section class="trailmap" id="trailmap"{% if areaData %} data-src="{{ ('/assets/trails/' + page.fileSlug + '.json') | htmlBaseUrl }}"{% endif %} data-base="{{ '/' | htmlBaseUrl }}"{% if map_trails == 'route only' %} data-route-only{% endif %} data-hint="Click a {% if areaData and map_trails != 'route only' %}trail{% else %}route{% endif %} to see its length and elevation profile, or anywhere for the weather forecast there.">
    <div class="tm-head"><h2>{% if areaData and map_trails != 'route only' %}Trails in {{ map }}{% else %}Routes and trailheads{% endif %}</h2><span class="tm-count hint"></span></div>
    {% if extras %}<script type="application/json" class="tm-extras">{{ extras | safe }}</script>{% endif %}
    <div class="tm-routes" hidden></div>
    <div class="tm-map" tabindex="0" aria-label="Trail map"></div>
    <div class="tm-legend"><span class="tm-has-routes" hidden><i class="ln route"></i>Your routes</span>{% if areaData %}{% if map_trails != 'route only' %}<span><i class="ln big"></i>Long-distance trail</span><span><i class="ln trail"></i>Trail</span><span><i class="ln closed"></i>Closed or abandoned</span><span><i class="ln bnd"></i>Boundary</span>{% endif %}{% endif %}<span><i class="tm-poi trailhead"></i>Trailhead</span>{% if camps %}<span><i class="tm-poi camp"></i>Camp</span>{% endif %}{% if areaData %}<span class="tm-more">Zoom in for {% if not camps %}camps, {% endif %}water, peaks{% if map_trails != 'route only' %}, dirt roads and unnamed paths{% endif %}</span>{% if not camps %}<span class="tm-zin"><i class="tm-poi camp"></i>Camp</span>{% endif %}<span class="tm-zin"><i class="tm-poi water"></i>Water</span><span class="tm-zin"><i class="tm-poi peak"></i>Peak</span>{% if map_trails != 'route only' %}<span class="tm-zin"><i class="ln road"></i>Dirt road</span>{% endif %}{% endif %}</div>
    <div class="tm-info"></div>
    <div class="tm-prof" hidden></div>
    <nav class="tm-plan" aria-label="Plan this trip"><span class="tm-rl">Plan this trip</span><a class="tm-ext" data-app="caltopo" href="https://caltopo.com/map.html" hidden>CalTopo</a><a class="tm-ext" data-app="gaia" href="https://www.gaiagps.com/map/" hidden>Gaia GPS</a>{% for label, url in links %}<a href="{{ url }}">{{ label }}</a>{% endfor %}</nav>
  </section>
  <script src="/assets/vendor/leaflet/leaflet.js" defer></script>
  <script src="/assets/trailmap.js" defer></script>
  {% elif links %}
  <nav class="tm-plan solo" aria-label="Plan this trip"><span class="tm-rl">Plan this trip</span>{% for label, url in links %}<a href="{{ url }}">{{ label }}</a>{% endfor %}</nav>
  {% endif %}
  {% set fc = { trailheads: trailheads, camps: camps, routes: routes } | forecastData(page.fileSlug) %}
  {% if fc %}
  <section class="forecast" id="forecast" aria-labelledby="fc-h">
    <div class="tm-head"><h2 id="fc-h">Weather forecast</h2><span class="fc-when hint"></span></div>
    <script type="application/json" class="fc-data">{{ fc | safe }}</script>
    <div class="fc-tabs tm-routes" hidden></div>
    <div class="fc-wrap"><table class="fc"></table></div>
    <p class="hint fc-foot">Click a place for its full National Weather Service forecast{% if areaData or extras %}, or click anywhere on the map for that spot{% endif %}. Hover a day for details.</p>
  </section>
  <script src="/assets/forecast.js" defer></script>
  {% endif %}
  <div class="cols">
    <article class="notes">
      {{ content | routeLinks(routes) | safe }}
      {% if updated %}<p class="updated">Research last updated {{ updated | readableDate }}</p>{% endif %}
    </article>
    <aside class="facts" aria-label="Quick facts">
      <dl>
        {% for label, value in facts %}<dt>{{ label }}</dt><dd>{{ value }}</dd>{% endfor %}
        {% if permit.note %}<dt>Permits</dt><dd>{{ permit.note }}</dd>{% endif %}
      </dl>
      {% set edit = page.inputPath | editUrl %}
      {% if edit %}<a class="edit" href="{{ edit }}">Edit this trip on GitHub</a>{% endif %}
    </aside>
  </div>
</main>
