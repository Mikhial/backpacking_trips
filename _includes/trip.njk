---
layout: base.njk
nav: trips
---
<main class="gutter">
  <header class="trip-head">
    <span class="eyebrow">{{ region }}</span>
    <h1>{{ name }}</h1>
    <div class="meta">
      {% if summary %}<span>{{ summary }}</span>{% endif %}
      {% if permit.difficulty %}<span title="{{ permit.why }}"><span class="meter">{{ permit.difficulty | dots | safe }}</span> {{ permit.difficulty | levelName }} permit{% if permit.why %} · {{ permit.why }}{% endif %}</span>{% endif %}
      {% if status %}<span class="chip warn">{{ status }}</span>{% endif %}
    </div>
  </header>
  {% set chartTrips = collections.trips | onlyPage(page.inputPath) %}
  {% set chartOptions = '{"groups": false, "link": false, "alwaysOpen": true}' %}
  {% set chartLegendDots = false %}
  {% include "chart.njk" %}
  {% if map and (page.fileSlug | hasTrailData) %}
  <link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
  <section class="trailmap" id="trailmap" data-src="/assets/trails/{{ page.fileSlug }}.json" data-hint="Click a trail to see its length and elevation profile.">
    <div class="tm-head"><h2>Trails in {{ map }}</h2><span class="tm-count hint"></span></div>
    <div class="tm-map" tabindex="0" aria-label="Map of trails in {{ map }}"></div>
    <div class="tm-legend"><span><i class="ln trail"></i>Trail</span><span><i class="ln road"></i>Dirt road</span><span><i class="ln closed"></i>Closed or abandoned</span><span><i class="ln bnd"></i>Boundary</span><span><i class="tm-poi trailhead"></i>Trailhead</span><span><i class="tm-poi camp"></i>Camp</span><span><i class="tm-poi peak"></i>Peak (zoom in)</span><span><i class="tm-poi water"></i>Water</span></div>
    <div class="tm-info"></div>
    <div class="tm-prof" hidden></div>
  </section>
  <script src="/assets/vendor/leaflet/leaflet.js" defer></script>
  <script src="/assets/trailmap.js" defer></script>
  {% endif %}
  <div class="cols">
    <article class="notes">
      {{ content | safe }}
      {% if updated %}<p class="updated">Research last updated {{ updated | readableDate }}</p>{% endif %}
    </article>
    <aside class="facts" aria-label="Quick facts">
      <dl>
        {% for label, value in facts %}<dt>{{ label }}</dt><dd>{{ value }}</dd>{% endfor %}
        {% if permit.note %}<dt>Permits</dt><dd>{{ permit.note }}</dd>{% endif %}
      </dl>
      {% set edit = page.inputPath | editUrl %}
      {% if edit %}<a class="edit" href="{{ edit }}">Edit this trip on GitHub</a>{% endif %}
    </aside>
  </div>
</main>
