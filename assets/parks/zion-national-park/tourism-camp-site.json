backpackinginfo.htm"},"at":[37.35912,-112.95156]},{"id":"n9109297399","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"4","fee":"yes","name":"Campsite 2 - River Bend","note":"A 10-15 minute walk beyond Deep Creek, River Bend is located on the right side of the point of a sharp bench 10 feet above the river. This site has a maximum group size of 4 and is available for walk-up permit only.","operator":"Zion National Park","reservation":"no","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.35493,-112.95167]},{"id":"n9109297400","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"6","caravans":"no","fee":"yes","name":"Campsite 3 - Right Bench","note":"A 10-15 minute walk beyond Deep Creek, River Bend is located on the right side of the point of a sharp bench 10 feet above the river. This site has a maximum group size of 6 and is available for walk-up permit only.","operator":"Zion National Park","reservation":"required","static_caravans":"no","tents":"yes","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.35313,-112.95055]},{"id":"n9109297401","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"2","fee":"yes","name":"Campsite 4 - Flat Rock","note":"Flat Rock is a 5-10 minute walk beyond Right Bench, located beside a large flat rock next to the river. The site is next to the rock, on a 6 foot high bench next to the canyon wall. This site has a maximum group size of 2 and is available for walk-up perm","operator":"Zion National Park","reservation":"no","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.35169,-112.94906]},{"id":"n9109297402","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"6","fee":"yes","name":"Campsite 5 - Ringtail","note":"Flat Rock is a 5-10 minute walk beyond Right Bench, located beside a large flat rock next to the river. The site is next to the rock, on a 6 foot high bench next to the canyon wall. This site has a maximum group size of 2 and is available for walk-up perm","operator":"Zion National Park","reservation":"required","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.35037,-112.9492]},{"id":"n9109297403","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"12","fee":"yes","name":"Campsite 6 - Kolob Creek","note":"At the confluence of Kolob Creek. The site is located on the right side, 20 feet above the river on a bench. This site has a maximum group size of 12 and is available for walk-up permit only.","operator":"Zion National Park","reservation":"no","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.3491,-112.95044]},{"id":"n9109297404","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"6","fee":"yes","name":"Campsite 7 - Box Elder","note":"A 10 minute walk beyond Kolob Creek. This site is located on the left about 30 feet up on a bench. This site has a maximum group size of 6 and is available for reservations online or on a walk-up basis.","operator":"Zion National Park","reservation":"required","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.34528,-112.95066]},{"id":"n9109297405","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"6","fee":"yes","name":"Campsite 8 - Boulder Camp","note":"Across the river from Box Elder, a 10 minute walk beyond Kolob Creek around a sharp bend. The access trail is to the right up slope about 50 feet. This site has a maximum group size of 6 and is available for walk-up permit only.","operator":"Zion National Park","reservation":"no","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.3448,-112.95066]},{"id":"n9109297406","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"6","fee":"yes","name":"Campsite 9 - Left Bench","note":"Across the river from Box Elder, a 10 minute walk beyond Kolob Creek around a sharp bend. The access trail is to the right up slope about 50 feet. This site has a maximum group size of 6 and is available for walk-up permit only.","operator":"Zion National Park","reservation":"required","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.34008,-112.95471]},{"id":"n9109297407","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"6","fee":"yes","name":"Campsite 10 - West Bend","note":"A 5 minute hike from Left Bench. This site is on a high bank located on a western bend. This site has a maximum group size of 6 and is available for walk-up permit only.","operator":"Zion National Park","reservation":"no","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.33861,-112.95742]},{"id":"n9109297408","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"4","fee":"yes","name":"Campsite 11 - Spotted Owl","note":"This sunny site is located on the left side, immediately after the first stream crossing. It is up a slope 10 feet above the river. This site has a maximum group size of 4 and is available for walk-up permit only.","operator":"Zion National Park","reservation":"no","tourism":"camp_site","website":"https://www.nps.gov/zion/planyourvisit/backpackinginfo.htm"},"at":[37.33332,-112.95546]},{"id":"n9109297409","k":"tourism=camp_site","tags":{"access":"permit","backcountry":"yes","capacity:persons":"12","fee":"yes","name":"Campsite 12 - High Camp","note":"High Camp is a 15-20 minute walk beyond Spotted Owl on a slow, difficult section of the river, 300 yards before Big Spring. T